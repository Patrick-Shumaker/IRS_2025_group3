PROGRAM timerbelt
  VAR
    btnConvyr AT %QX0.0 : BOOL;
    motor AT %QX0.1 : BOOL;
    pulse AT %QX0.2 : BOOL;
    reset AT %QX0.3 : BOOL;
    weightSens AT %MW0 : INT;
    totalCount AT %MW1 : INT := 0;
    bigCount AT %MW2 : INT := 0;
    mediumCount AT %MW3 : INT := 0;
    smallCount AT %MW4 : INT := 0;
  END_VAR
  VAR
    bigCounter : CTU;
    mediumCounter : CTU;
    smallCounter : CTU;
    posATimer : TON;
    posBTimer : TON;
    posCTimer : TON;
    bigTimerPreset : TIME := T#2.4s;
    mediumTimerPreset : TIME := T#3.8s;
    smallTimerPreset : TIME := T#5s;
    preset : INT := 100;
    ten : INT := 10;
    five : INT := 5;
    zero : INT := 0;
    _TMP_GT16_OUT : BOOL;
    _TMP_GT18_OUT : BOOL;
    _TMP_LE21_OUT : BOOL;
    _TMP_AND22_OUT : BOOL;
    _TMP_LE25_OUT : BOOL;
    _TMP_GT33_OUT : BOOL;
    _TMP_AND30_OUT : BOOL;
    _TMP_OR11_OUT : BOOL;
    _TMP_NOT12_OUT : BOOL;
    R_TRIG1 : R_TRIG;
    R_TRIG2 : R_TRIG;
    R_TRIG3 : R_TRIG;
    _TMP_ADD44_OUT : INT;
  END_VAR

  _TMP_GT16_OUT := GT(weightSens, ten);
  posATimer(IN := _TMP_GT16_OUT, PT := bigTimerPreset);
  _TMP_GT18_OUT := GT(weightSens, five);
  _TMP_LE21_OUT := LE(weightSens, ten);
  _TMP_AND22_OUT := AND(_TMP_GT18_OUT, _TMP_LE21_OUT);
  posBTimer(IN := _TMP_AND22_OUT, PT := mediumTimerPreset);
  _TMP_LE25_OUT := LE(weightSens, five);
  _TMP_GT33_OUT := GT(weightSens, zero);
  _TMP_AND30_OUT := AND(_TMP_LE25_OUT, _TMP_GT33_OUT);
  posCTimer(IN := _TMP_AND30_OUT, PT := smallTimerPreset);
  _TMP_OR11_OUT := OR(posATimer.Q, posBTimer.Q, posCTimer.Q);
  _TMP_NOT12_OUT := NOT(_TMP_OR11_OUT);
  motor := _TMP_NOT12_OUT;
  R_TRIG1(CLK := pulse AND _TMP_AND30_OUT);
  smallCounter(CU := R_TRIG1.Q, R := reset, PV := preset);
  smallCount := smallCounter.CV;
  R_TRIG2(CLK := pulse AND _TMP_AND22_OUT);
  mediumCounter(CU := R_TRIG2.Q, R := reset, PV := preset);
  mediumCount := mediumCounter.CV;
  R_TRIG3(CLK := pulse AND _TMP_GT16_OUT);
  bigCounter(CU := R_TRIG3.Q, R := reset, PV := preset);
  bigCount := bigCounter.CV;
  _TMP_ADD44_OUT := ADD(bigCount, mediumCount, smallCount);
  totalCount := _TMP_ADD44_OUT;
END_PROGRAM


CONFIGURATION Config0

  RESOURCE Res0 ON PLC
    TASK task0(INTERVAL := T#20ms,PRIORITY := 0);
    PROGRAM instance0 WITH task0 : timerbelt;
  END_RESOURCE
END_CONFIGURATION

